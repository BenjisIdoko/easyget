# Public site URL (used for Paystack callback_url). Set this to your real
# domain in production (e.g. https://easyget.com.ng).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# WhatsApp Business number the "Talk to a Pharmacist" / support links open,
# in international format with no + or spaces (e.g. 2348012345678).
NEXT_PUBLIC_WHATSAPP_NUMBER=2348000000000

# Paystack — https://dashboard.paystack.com/#/settings/developer
# Secret key is server-only; never expose it with a NEXT_PUBLIC_ prefix.
PAYSTACK_SECRET_KEY=

# Supabase — optional while the app runs on the mock catalog in
# src/lib/products.ts. Set these once you provision a project and run
# supabase/schema.sql to start reading/writing real data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
